DATABASE_URL=postgres://customs:customs@localhost:5432/customs
TEST_DATABASE_URL=postgres://customs:customs@localhost:5432/customs_test

# Authentication secret – must be set in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=

PORT=4000
FILE_STORAGE_DIR=./storage

# Field-level AES-256-GCM encryption key for PII at rest (RNF-03/08).
# Must be set in production; missing/wrong-length key causes a boot error.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# F20a: HMAC-SHA256 pepper for deterministic blind-index dedup tokens.
# Separate from FIELD_ENCRYPTION_KEY so each key can be rotated independently.
# Must be set in production; missing/wrong-length pepper causes a boot error.
# Generate with: openssl rand -base64 32
BLIND_INDEX_PEPPER=

# ---------------------------------------------------------------------------------------------
# Outbound SMTP (#22). Placeholders only — real values live in Coolify.
#
# Optional by design: with SMTP_HOST or SMTP_FROM unset, services/mailer.ts records every send as
# `omitido` and no request path fails. The risk requirement (R18) will NOT start its deadline clock
# against a client it could not notify, so leaving this unset is safe — just silent.
# ---------------------------------------------------------------------------------------------
SMTP_HOST=
# 587 (STARTTLS) or 465 (implicit TLS). SMTP_SECURE defaults from the port; override only if needed.
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# RFC5322 From. Bare address or "Name <addr>".
SMTP_FROM=
SMTP_TIMEOUT_MS=20000

# Offload window added to eta_pais to derive a risk requirement's hard deadline (R18/D13).
# Default 3 hours (PRD-02 §16 supuestos).
REQUERIMIENTO_VENTANA_HORAS=3

# ---------------------------------------------------------------------------------------------
# Cincel — NOM-151 digital signature for client convenios (PRD-02 Excel item 8, R25/D9).
# Placeholders only — real values live in Coolify.
#
# Optional by design: with CINCEL_API_URL or CINCEL_API_KEY unset, services/cincel.ts records every
# signature request as `omitido` (recorded locally as pending-but-not-sent) and no request path
# fails. A convenio can always be uploaded and stored, hashed, with or without Cincel configured.
# ---------------------------------------------------------------------------------------------
CINCEL_API_URL=
CINCEL_API_KEY=
CINCEL_TIMEOUT_MS=20000
# HMAC secret Cincel signs its signature-completion webhook with (X-Cincel-Signature: t=…,v1=…).
# Unset = the webhook fails CLOSED (503), same posture as AGORA_WEBHOOK_SIGNING_SECRET.
CINCEL_WEBHOOK_SECRET=
CINCEL_SIGNATURE_TOLERANCE_SEC=300
