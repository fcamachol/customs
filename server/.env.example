DATABASE_URL=postgres://customs:customs@localhost:5432/customs
TEST_DATABASE_URL=postgres://customs:customs@localhost:5432/customs_test

# Authentication secret – must be set in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=

PORT=4000
FILE_STORAGE_DIR=./storage

# Field-level AES-256-GCM encryption key for PII at rest (RNF-03/08).
# Must be set in production; missing/wrong-length key causes a boot error.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# F20a: HMAC-SHA256 pepper for deterministic blind-index dedup tokens.
# Separate from FIELD_ENCRYPTION_KEY so each key can be rotated independently.
# Must be set in production; missing/wrong-length pepper causes a boot error.
# Generate with: openssl rand -base64 32
BLIND_INDEX_PEPPER=
